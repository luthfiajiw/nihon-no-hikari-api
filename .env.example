# APP
APP_TAG=dev

# Server
SERVER_PORT=

# Database
DB_USER=root
DB_SOURCE=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
API_PORT=

# JWT
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_DURATION=
REFRESH_TOKEN_DURATION=
SESSION_CACHE_TTL=

# Google Sign-In (optional; leave empty to disable POST /api/v1/auth/google)
GOOGLE_CLIENT_ID=

# Azure Speech (optional; leave empty to disable lesson text-to-speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Supabase private Storage (uploads and media URL reads need server credentials)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KOTOBA_COVER_BUCKET=
SUPABASE_KOTOBA_AUDIO_BUCKET=


# SMTP (optional; needed for email verification such as linking Google)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gakkobit.com
